{
    "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentParameters.json#",
    "contentVersion": "1.0.0.0",
    "parameters": {
        "name": {
            "value": "${AZURE_ENV_NAME}",
            "metadata": {
                "description": "Specifies the name of the app."
            }
        },
        "location": {
            "value": "${AZURE_LOCATION}",
            "metadata": {
                "description": "Specifies the location for all resources."
            }
        },
        "keyVaultResourceId": {
            "value": "${CONFIG_KEY_VAULT_RESOURCE_ID}",
            "metadata": {
                "description": "ARM ID of the existing RBAC Key Vault containing configuration secrets."
            }
        },
        "deploymentCapacity": {
            "value": "${OPENAI_CAPACITY}",
            "metadata": {
                "description": "The OpenAI endpoints capacity (in thousands of tokens per minute)."
            }
        }
    }
}
